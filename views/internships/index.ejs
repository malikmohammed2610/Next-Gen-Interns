<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><p class="eyebrow">OPPORTUNITY DIRECTORY</p><h1>Explore <span>internships.</span></h1><p class="muted">Only published listings marked verified appear here. Always review the role and employer details before applying.</p>
<% if (!internships.length) { %><div class="empty-state"><div class="empty-icon">✦</div><h2>Fresh opportunities are on the way.</h2><p>There are no verified and published internships yet.</p></div><% } else { %>
<div class="internship-grid"><% internships.forEach(function(item) { %><article class="internship-card"><div class="card-meta"><span class="verified-badge">✓ Verified review</span><span><%= item.work_mode || "Not specified" %></span></div><h2><a href="/internships/<%= item.id %>"><%= item.title %></a></h2><p class="company"><%= item.company_name %></p><p class="muted"><%= item.location || "Location not specified" %> · <%= item.duration || "Duration not specified" %></p><div class="stipend"><%= item.currency || "INR" %> <%= Number(item.stipend_min || 0).toLocaleString("en-IN") %>–<%= Number(item.stipend_max || 0).toLocaleString("en-IN") %><small> / month</small></div><a class="text-link" href="/internships/<%= item.id %>">View opportunity ↗</a></article><% }) %></div><% } %>
</main><%- include("../partials/footer") %><%- include("../partials/scripts") %>
