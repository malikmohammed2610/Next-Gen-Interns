<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><a class="back-link" href="/internships">← All internships</a><section class="detail-panel"><span class="verified-badge">✓ Admin-reviewed listing</span><p class="eyebrow"><%= internship.category || "INTERNSHIP" %></p><h1><%= internship.title %></h1><h2 class="company"><%= internship.company_name %></h2><div class="detail-facts"><span>⌖ <%= internship.location || "Location not specified" %></span><span>◷ <%= internship.duration || "Duration not specified" %></span><span>◈ <%= internship.work_mode || "Work mode not specified" %></span></div><div class="stipend large"><%= internship.currency || "INR" %> <%= Number(internship.stipend_min || 0).toLocaleString("en-IN") %>–<%= Number(internship.stipend_max || 0).toLocaleString("en-IN") %><small> / month</small></div><div class="detail-copy"><h3>About this opportunity</h3><p><%= internship.description || "The employer has not provided a description yet." %></p><h3>Requirements</h3><p><%= internship.requirements || "Please review the role details with the employer." %></p><% if (internship.application_deadline) { %><p><b>Application deadline:</b> <%= new Date(internship.application_deadline).toLocaleDateString("en-IN") %></p><% } %></div>
<% if (currentUser) { %><form method="post" action="/applications/<%= internship.id %>"><button class="button" type="submit">Apply for this internship ↗</button></form><% } else { %><a class="button" href="/register">Register to apply ↗</a><p class="muted small-note">You must have an account to submit an application.</p><% } %></section></main>
<%- include("../partials/footer") %><%- include("../partials/scripts") %>
