<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><p class="eyebrow">MEMBERSHIP OPTIONS</p><h1>Choose support for <span>your journey.</span></h1><p class="muted">Plan fees are for platform and career-support features, not for an internship, selection, or guaranteed stipend.</p>
<div class="plan-grid"><% if (!plans.length) { %><% const defaults = [{name:"Gold",price:0,currency:"INR",features:"Core platform access and application tracking"},{name:"Diamond",price:499,currency:"INR",features:"Expanded career tools and application insights"},{name:"Platinum",price:999,currency:"INR",features:"Premium career support and progress analytics"}]; defaults.forEach(function(plan, i) { %><article class="plan-card <%= i===1 ? 'featured-plan' : '' %>"><p class="eyebrow"> <%= i===0?'FOUNDATION':i===1?'GROWTH':'ADVANCED' %> </p><h2><%= plan.name %></h2><p class="plan-price"><%= plan.currency %> <%= plan.price.toLocaleString("en-IN") %><small> / illustrative price</small></p><p><%= plan.features %></p><p class="muted">Checkout will be enabled after payment integration.</p><a class="button button-ghost button-full" href="/register">Get started</a></article><% }) %><% } else { plans.forEach(function(plan, i) { %><article class="plan-card <%= i===1 ? 'featured-plan' : '' %>"><p class="eyebrow">CAREER SUPPORT</p><h2><%= plan.name %></h2><p class="plan-price"><%= plan.currency %> <%= Number(plan.price).toLocaleString("en-IN") %></p><p><%= plan.features %></p><a class="button button-ghost button-full" href="/register">Get started</a></article><% }) } %></div>
<p class="muted small-note">Stipends are set by employers for each role and do not increase because a user selects a membership plan.</p></main><%- include("../partials/footer") %><%- include("../partials/scripts") %>
