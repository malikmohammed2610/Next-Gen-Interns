<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><p class="eyebrow">ADMINISTRATION</p><h1>Internship <span>review.</span></h1><p class="muted">Do not publish a role until employer identity, role details, stipend, and application method have been reviewed.</p>
<% if (!internships.length) { %><div class="empty-state"><h2>No internship submissions yet.</h2></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Role</th><th>Company</th><th>Verification</th><th>Publication</th><th>Update</th></tr></thead><tbody><% internships.forEach(function(i) { %><tr><td><%= i.title %></td><td><%= i.company_name %></td><td><%= i.verification_status %></td><td><%= i.publication_status %></td><td><form class="status-form" method="post" action="/admin/internships/<%= i.id %>/status"><select name="publicationStatus" aria-label="Publication status"><option value="pending">Pending</option><option value="published">Publish</option><option value="rejected">Reject</option></select><button class="button button-small" type="submit">Save</button></form></td></tr><% }) %></tbody></table></div><% } %></main>
<%- include("../partials/footer") %><%- include("../partials/scripts") %>
