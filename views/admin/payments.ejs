<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><p class="eyebrow">FINANCE</p><h1>Payment <span>records.</span></h1><p class="muted">Only provider-verified payment events should be recorded as captured. This view does not itself collect payments.</p>
<% if (!payments.length) { %><div class="empty-state"><h2>No payment records found.</h2><p>Records will appear after the payment integration is configured.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>User</th><th>Amount</th><th>Provider</th><th>Payment reference</th><th>Status</th><th>Date</th></tr></thead><tbody><% payments.forEach(function(p) { %><tr><td><%= p.full_name %><br><small><%= p.email %></small></td><td><%= p.currency %> <%= Number(p.amount).toLocaleString("en-IN") %></td><td><%= p.provider || "—" %></td><td><%= p.provider_payment_id || "—" %></td><td><%= p.status %></td><td><%= new Date(p.created_at).toLocaleDateString("en-IN") %></td></tr><% }) %></tbody></table></div><% } %></main>
<%- include("../partials/footer") %><%- include("../partials/scripts") %>
