<%- include("../partials/head", { title: title }) %><%- include("../partials/header") %>
<main class="container content-page"><p class="eyebrow">YOUR SPACE</p><h1>Welcome back, <span><%= currentUser.fullName %>.</span></h1><p class="muted">Manage your applications and review your career-support plan status.</p>
<section class="dashboard-section"><div class="section-heading"><h2>Your applications</h2><a class="text-link" href="/internships">Explore internships ↗</a></div>
<% if (!applications.length) { %><div class="empty-state"><h3>Your journey starts with an application.</h3><p>Explore verified listings to find a role that suits you.</p><a class="button" href="/internships">Browse internships</a></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Role</th><th>Company</th><th>Status</th><th>Submitted</th></tr></thead><tbody><% applications.forEach(function(a) { %><tr><td><%= a.title %></td><td><%= a.company_name %></td><td><span class="status-pill"><%= a.status %></span></td><td><%= new Date(a.created_at).toLocaleDateString("en-IN") %></td></tr><% }) %></tbody></table></div><% } %></section>
<section class="dashboard-section"><div class="section-heading"><h2>Your plans</h2><a class="text-link" href="/plans">Compare plans ↗</a></div><% if (!subscriptions.length) { %><p class="muted">No active plan record yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Plan</th><th>Status</th><th>Starts</th><th>Ends</th></tr></thead><tbody><% subscriptions.forEach(function(s) { %><tr><td><%= s.plan_name %></td><td><%= s.status %></td><td><%= s.starts_at ? new Date(s.starts_at).toLocaleDateString("en-IN") : "—" %></td><td><%= s.ends_at ? new Date(s.ends_at).toLocaleDateString("en-IN") : "—" %></td></tr><% }) %></tbody></table></div><% } %></section></main>
<%- include("../partials/footer") %><%- include("../partials/scripts") %>
